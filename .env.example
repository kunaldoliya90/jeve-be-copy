# Copy to .env (git-ignored) for local development. Never commit real values.
#
# FLAVOUR (dev | stag | prod, default dev) selects the settings class. It is read from
# the shell or container environment only, never from this file; the stag/prod images
# set it, and the deployment can override it. Only the dev flavour reads .env at all.

# --- application ----------------------------------------------------------
# APP_ prefix + the field name in app/core/settings/base.py. Defaults shown.
# APP_APP_NAME=jeve-be
# APP_API_PREFIX=/api/jeve
# APP_DEBUG=true
# APP_LOG_LEVEL=DEBUG

# --- OpenAI on Azure AI Foundry -------------------------------------------
# The whole OPENAI_SETTINGS dict replaced as one JSON object: there is no per-key merge.
# BASE_URL is the Azure *v1* surface, which is OpenAI-SDK compatible and hosts both
# /responses and /chat/completions, so pointing at a gateway needs no code change. The
# model is a deployment name on that resource, pinned in app/api/consts.py.
#
# API_KEY is a secret: paste it into .env only. It is read into a SecretStr at startup
# and used solely for the Authorization header - never logged, never sent in a prompt.
# APP_OPENAI_SETTINGS={"BASE_URL": "https://openai-compliance-tool.services.ai.azure.com/openai/v1", "API_KEY": "", "TIMEOUT_SECONDS": 300}

# --- review harness -------------------------------------------------------
# Limits from the low-level design, section 17. Defaults shown. Each one is read by the
# lifespan and passed into the orchestrator, so overriding it here changes a review.
# APP_MAX_UPLOAD_MB=25
# APP_MAX_ACTIVE_REVIEWS=4
# APP_TOOL_WORKERS=8
# APP_REVIEW_DEADLINE_S=600
# APP_STRUCTURE_CONTEXT_MAX_TOKENS=8000
# APP_FIGURE_SAMPLES=10

# --- docker-compose only --------------------------------------------------
# Host port for the API (make start). Default 8000.
# API_HOST_PORT=8001
